+
+    classes = {k.split(":", 1)[0] for k in stale}
+    unknown = sorted(c for c in classes if c not in REBUILD_STAGE)
+    stages = [st for st in STAGE_ORDER if any(REBUILD_STAGE.get(c) == st for c in classes)]
