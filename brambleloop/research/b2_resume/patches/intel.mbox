+def _db() -> Database:
+    db = Database(f"sqlite:///{tempfile.mkdtemp(prefix='cert_intel2_')}/w.sqlite")
+    db.create_all()
+    Registry(db).seed_defaults()
+    benchmarks.seed(db)
+    return db
