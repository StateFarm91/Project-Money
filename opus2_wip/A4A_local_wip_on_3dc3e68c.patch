+# A4A-1: the finished size an object noun promises, deterministic and measured on the twin.
+# A name that says "dishcloth" over a 38 x 11 cm strip promises an object the pattern does not
+# make. (min_cm, max_cm) on BOTH sides, plus the most a "square" object may be out of square.
+# Sources: the house's own engineered dishcloths/washcloths are 22 cm square
+# (products.pipeline_board PROPOSALS); common published potholder/hot-pad sizes sit at
+# 18-23 cm. A band, not a point, so a maker's gauge drift is not a refusal.
+OBJECT_SIZE_BANDS: tuple[tuple[str, tuple[float, float], float], ...] = (
+    (r"\b(?:dish|wash|face)\s*-?\s*cloths?\b", (18.0, 28.0), 1.25),
+    (r"\b(?:hot\s*pads?|pot\s*-?\s*holders?|trivets?)\b", (15.0, 25.0), 1.25),
+)
+
+
+def check_object_size_claims(text: str, cir: CIR, twin: TwinModel,
+                             where: str = "product.title") -> list[Finding]:
+    """A4A-1: does the finished piece have the size the object noun promises?"""
+    import re as _re
+    import unicodedata
+
+    try:                     # the one shared fold (A1-R); this base predates it
+        from ..products.text_fold import fold
+    except ImportError:
+        def fold(t):
+            return unicodedata.normalize("NFKC", str(t or "")).lower()
+    low = " ".join(fold(text).split())
+    out: list[Finding] = []
+    w = getattr(twin, "width_cm", None)
+    h = getattr(twin, "height_cm", None)
+    for pattern, (lo, hi), max_ratio in OBJECT_SIZE_BANDS:
+        m = _re.search(pattern, low)
+        if not m:
+            continue
+        if not w or not h:
+            out.append(Finding(ERROR, "OBJECT_SIZE_UNKNOWN",
+                               f"{where} names {m.group(0)!r} but the twin has no finished "
+                               f"width and height to measure it against"))
+            continue
+        ratio = max(w, h) / min(w, h)
+        if not (lo <= w <= hi and lo <= h <= hi) or ratio > max_ratio:
+            out.append(Finding(ERROR, "OBJECT_SIZE_OUT_OF_BAND",
+                               f"{where} names {m.group(0)!r}, which is {lo:g}-{hi:g} cm "
+                               f"each side and about square; the pattern makes "
+                               f"{w:.1f} x {h:.1f} cm"))
+    return out
+
+
 def check_technique_claims(text: str, cir: CIR, twin: TwinModel,
