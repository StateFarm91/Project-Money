+def _reopen_number(db, rec: dict, pod: str, *, today: date, now: datetime) -> int:
+    """A4A-3: the reopen number (1..MAX_REOPENS) when this ended gap's recorded evidence has
+    changed since it ended, else 0. A gap in flight, a proposal that went on to intake, or a
+    gap that has used its reopens is never re-opened."""
+    st, outcome = status(db, rec, now=now)
+    if st != "done" or not (outcome in NAMED_ENDS or outcome == "stalled"):
+        return 0
+    used = int(rec.get("reopens") or 0)
+    if used >= MAX_REOPENS:
+        return 0
+    current = observe(db, pod, today=today)["fingerprint"]
+    if current == rec.get("evidence"):
+        return 0
+    return used + 1
+
